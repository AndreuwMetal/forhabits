{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // los self-check corren con `node scripts/selfcheck.ts`, que exige la extensión
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  // supabase/ es código Deno: lo comprueba el CLI de Supabase, no tsc
  "exclude": ["node_modules", "supabase"]
}
