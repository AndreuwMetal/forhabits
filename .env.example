# Variables públicas de Expo (EXPO_PUBLIC_*): se inlinean en el bundle en
# tiempo de build, así que NO pongas aquí secretos de Stripe ni claves
# service_role de Supabase. Esos viven en los secretos de las Edge Functions
# (`supabase secrets set ...`), no en el cliente.
#
# Copia este fichero a .env (o .env.local, que ya está ignorado por git) y
# rellena los valores cuando saques la app a producción. Sin este fichero,
# o con variables vacías, la app sigue funcionando en modo local: cohorte
# simulada y desbloqueo premium local de desarrollo.

# Panel del proyecto Supabase → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Panel del proyecto Supabase → Project Settings → API Keys → anon / public
# (es una clave pública, segura para el cliente: las políticas RLS protegen los datos)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard de Stripe → Product catalog → tu producto Premium → Price → Price ID (price_...)
# Lo usa la Edge Function create-checkout para crear la sesión de Stripe Checkout
EXPO_PUBLIC_STRIPE_PRICE_ID=
