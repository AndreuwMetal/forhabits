{
  "expo": {
    "name": "ForHabits",
    "slug": "forhabits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07030F",
    "scheme": "forhabits",
    "primaryColor": "#B026FF",
    "description": "Aplica las 4 leyes de Hábitos Atómicos para construir hábitos buenos y eliminar los malos.",
    "githubUrl": "https://github.com/AndreuwMetal/forhabits",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andreuwmetal.forhabits",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserNotificationsUsageDescription": "ForHabits te avisa cada día para registrar tus hábitos y te envía tu análisis semanal.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andreuwmetal.forhabits",
      "adaptiveIcon": {
        "backgroundColor": "#07030F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#B026FF"
        }
      ]
    ],
    "owner": "andreuwmetal",
    "extra": {
      "eas": {
        "projectId": "c3149146-fa7d-4cc0-95ae-88360c317dd7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c3149146-fa7d-4cc0-95ae-88360c317dd7"
    }
  }
}
